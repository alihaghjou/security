// =============================================================================
// SecureFlow - Prisma Schema
// Self-Service Cybersecurity & Software Vulnerability Assistant
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SecurityMode {
  PERSONAL
  DEVELOPER
}

enum PriorityLevel {
  FIX_URGENTLY
  UPDATE_RECOMMENDED
  MONITOR
  NEEDS_VERIFICATION
}

enum FindingStatus {
  CONFIRMED_AFFECTED
  POTENTIALLY_AFFECTED
  VERIFIED_FIXED
  NEEDS_VERIFICATION
  RISK_ACCEPTED
}

enum VerificationOutcome {
  FIXED_CONFIRMED
  STILL_AFFECTED
  UNABLE_TO_VERIFY
}

enum NotificationPriority {
  CRITICAL
  WARNING
  INFO
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  passwordHash  String?
  mode          SecurityMode    @default(PERSONAL)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  watchlist     WatchlistEntry[]
  projects      Project[]
  notifications Notification[]

  @@map("users")
}

model WatchlistEntry {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  ecosystem       String          // "npm", "PyPI", "Go", "crates.io", "Maven", "General"
  currentVersion  String
  platform        String?         // "Desktop", "Web", "Server", "Mobile"
  isMonitored     Boolean         @default(true)
  lastCheckedAt   DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  findings        VulnerabilityFinding[]
  verifications   FixVerificationRecord[]

  @@index([userId])
  @@map("watchlist_entries")
}

model Project {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  ecosystem         String
  sourceFilename    String?
  totalDependencies Int                 @default(0)
  vulnerableCount   Int                 @default(0)
  lastScannedAt     DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  dependencies      ProjectDependency[]

  @@index([userId])
  @@map("projects")
}

model ProjectDependency {
  id          String                 @id @default(uuid())
  projectId   String
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  version     String
  isDirect    Boolean                @default(true)
  ecosystem   String
  createdAt   DateTime               @default(now())

  findings    VulnerabilityFinding[]

  @@index([projectId])
  @@map("project_dependencies")
}

model VulnerabilityFinding {
  id                  String             @id @default(uuid())
  watchlistEntryId    String?
  watchlistEntry      WatchlistEntry?    @relation(fields: [watchlistEntryId], references: [id], onDelete: Cascade)
  projectDependencyId String?
  projectDependency   ProjectDependency? @relation(fields: [projectDependencyId], references: [id], onDelete: Cascade)

  advisoryId          String             // e.g., "GHSA-xxxx-xxxx-xxxx" or "CVE-2023-xxxx"
  aliases             String[]           @default([])
  title               String
  summary             String
  severity            String             // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  cvssScore           Float?
  epssScore           Float?             // Probability score (0.0 to 1.0)
  isKev               Boolean            @default(false) // Known Exploited Vulnerability
  priority            PriorityLevel      @default(MONITOR)
  affectedRange       String?
  fixedVersion        String?
  status              FindingStatus      @default(CONFIRMED_AFFECTED)
  sourceUrl           String?
  detectedAt          DateTime           @default(now())
  resolvedAt          DateTime?

  @@index([watchlistEntryId])
  @@index([projectDependencyId])
  @@index([advisoryId])
  @@map("vulnerability_findings")
}

model FixVerificationRecord {
  id               String              @id @default(uuid())
  watchlistEntryId String
  watchlistEntry   WatchlistEntry      @relation(fields: [watchlistEntryId], references: [id], onDelete: Cascade)
  advisoryId       String
  previousVersion  String
  newVersion       String
  outcome          VerificationOutcome
  notes            String
  verifiedAt       DateTime            @default(now())

  @@index([watchlistEntryId])
  @@map("fix_verification_records")
}

model Notification {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  priority    NotificationPriority @default(INFO)
  isRead      Boolean              @default(false)
  advisoryId  String?
  createdAt   DateTime             @default(now())

  @@index([userId])
  @@map("notifications")
}
